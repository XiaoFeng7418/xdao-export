# 构建产物
build/
dist/
*.spec

# 打包好的可执行文件：跟上游仓库的习惯一致，只作为 Release 附件发布，
# 不进源码树（体积大，且每次打包都会变）。
/X岛串导出工具.exe

# Python 缓存
__pycache__/
*.pyc

# 调试/临时脚本（只忽略仓库根目录下的，避免误伤 tools/ 等目录）
/_*.py
_session.*
_hash.txt

# 运行期缓存与导出产物
.cache/
*.egg-info/
.pytest_cache/
pytest-cache-files-*/

# 测试产物：目录本身要保留（受限环境要求预先存在才能写入），
# 但跑出来的东西不进版本库。
.test-artifacts/*
